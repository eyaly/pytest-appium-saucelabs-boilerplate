# Copy to .env and fill in. Never commit .env.
# SAUCE_USERNAME / SAUCE_ACCESS_KEY can also come from system environment
# variables; uncomment only if they are not set in your system.
# SAUCE_USERNAME=
# SAUCE_ACCESS_KEY=

# Data center: eu-central-1 (default) | us-west-1
# (EU_CENTRAL / US_WEST are accepted too)
# SAUCE_REGION=eu-central-1

# Optional: shared build name (defaults to a timestamped name per run)
# SAUCE_BUILD_NAME=

# Apps uploaded to Sauce Storage
ANDROID_APP=storage:filename=SauceLabs-Demo-App.apk
IOS_APP=storage:filename=SauceLabs-Demo-App.ipa

# Device selection (regex allowed, e.g. "Google.*", "iPhone.*")
ANDROID_DEVICE=Google.*
ANDROID_PLATFORM_VERSION=
IOS_DEVICE=iPhone.*
IOS_PLATFORM_VERSION=
